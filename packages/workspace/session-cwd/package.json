{
  "name": "@dsh-cc/session-cwd",
  "description": "Session working-directory facade for DeepSeek Harness CC: the harness workingDirectory service owns the session cwd (legacy worktree/entered log hydration), with the getSessionCwd/resolveSessionCwd APIs and a pre-execute workspace boundary guard",
  "version": "0.9.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-cc/dsh-cc.git",
    "directory": "packages/workspace/session-cwd"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@dsh-cc/tools": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../../../../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-fs-local": "link:../../../../deepseek-harness/packages/fs/fs-local",
    "@deepseek-ai/dsh-llm": "link:../../../../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../../../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-session-projection": "link:../../../../deepseek-harness/packages/session/session-projection",
    "@deepseek-ai/dsh-working-directory": "link:../../../../deepseek-harness/packages/session/working-directory",
    "@deepseek-ai/schemastery": "link:../../../../deepseek-harness/vendor/schemastery",
    "@dsh-cc/tools": "link:../../core/tools"
  },
  "publishConfig": {
    "access": "public"
  }
}
