{
  "name": "@dsh-cc/tui",
  "version": "0.6.0",
  "description": "Claude Code-style terminal surface for the dsh tui profile (CC agent preset)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "presets",
    "scripts/stage-preset.mjs"
  ],
