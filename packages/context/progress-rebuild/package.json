{
  "name": "@dsh-cc/progress-rebuild",
  "description": "Post-compaction progress rebuild: derives a per-session shadow state (goal/todos/verified receipts/last real user instruction) from session events and injects a small derived brief after each successful compaction",
  "version": "0.9.0-rc.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-cc/dsh-cc.git",
    "directory": "packages/context/progress-rebuild"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "@dsh-cc/settings-ns": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../../../../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-agent-loop": "link:../../../../deepseek-harness/packages/core/agent-loop",
    "@deepseek-ai/dsh-agent-loop-testkit": "link:../../../../deepseek-harness/packages/test-support/agent-loop-testkit",
    "@deepseek-ai/dsh-llm": "link:../../../../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../../../deepseek-harness/packages/core/session",
    "@dsh-cc/advisor-watchdog": "workspace:^",
    "@dsh-cc/memory": "workspace:^",
    "@dsh-cc/turn-rules": "workspace:^",
    "@dsh-cc/settings-provider": "workspace:^",
    "@dsh-cc/settings-ns": "workspace:^",
    "@deepseek-ai/schemastery": "link:../../../../deepseek-harness/vendor/schemastery",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
