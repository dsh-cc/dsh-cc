{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(read|grep)$|^mcp__serena__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/serena-remind.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/serena-session-cleanup.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
