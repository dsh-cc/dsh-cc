{
  "name": "@dsh-cc/settings-cascade",
  "description": "Claude Code-style five-level settings cascade provider (ctx.settings) for the DeepSeek Harness",
  "version": "0.6.3-rc.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-cc/dsh-cc.git",
    "directory": "packages/settings/settings-cascade"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./permissions": {
      "types": "./lib/permissions.d.ts",
      "default": "./lib/permissions.js"
    },
    "./local-root": {
      "types": "./lib/local-root.d.ts",
      "default": "./lib/local-root.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "files": [
    "lib"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1",
    "@deepseek-ai/cordis": ">=0.1.2-rc.1",
    "@deepseek-ai/schemastery": ">=0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": "link:../../../../deepseek-harness/packages/util/home-paths",
    "@deepseek-ai/dsh-invariants": "link:../../../../deepseek-harness/packages/runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-settings": "link:../../../../deepseek-harness/packages/settings/settings",
    "@deepseek-ai/cordis": "link:../../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/schemastery": "link:../../../../deepseek-harness/vendor/schemastery"
  },
  "publishConfig": {
    "access": "public"
  }
}
