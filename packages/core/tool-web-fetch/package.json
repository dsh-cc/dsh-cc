{
  "name": "@dsh-cc/tool-web-fetch",
  "description": "CC-style web_fetch replacement with an optional prompt: summarizes the fetched page on the cheap lane (haiku alias) when configured; passing a prompt without haiku fails before fetching",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-cc/dsh-cc.git",
    "directory": "packages/core/tool-web-fetch"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-tool-web": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-web": ">=0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@dsh-cc/model-aliases": "workspace:^",
    "@dsh-cc/tools": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-invariants": "link:../../../../deepseek-harness/packages/runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "link:../../../../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-system-prompt": "link:../../../../deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-tool-web": "link:../../../../deepseek-harness/packages/web/tool-web",
    "@deepseek-ai/dsh-web": "link:../../../../deepseek-harness/packages/web/web",
    "@deepseek-ai/schemastery": "link:../../../../deepseek-harness/vendor/schemastery",
    "@dsh-cc/model-aliases": "workspace:^",
    "@dsh-cc/tools": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
