{
  "name": "@dsh-cc/tool-search",
  "description": "Deferred tool registration and a ToolSearch model tool that loads heavy tools on demand",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-cc/dsh-cc.git",
    "directory": "packages/core/tool-search"
  },
