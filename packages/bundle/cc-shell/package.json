{
  "name": "@dsh-cc/bundle-shell",
  "version": "0.9.0-rc.3",
  "description": "CC shell host-plane infra: tools registry swap (deferred-name support) + settings migrations; the glue plugin code lives here but is mounted by the CC preset (packages/preset/cc)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./schedule-mount": {
      "types": "./lib/schedule-mount.d.ts",
      "default": "./lib/schedule-mount.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-cc/dsh-cc.git",
    "directory": "packages/bundle/cc-shell"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-schedule": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "@dsh-cc/claude-code-agents": "workspace:^",
    "@dsh-cc/hook-protocol": "workspace:^",
    "@dsh-cc/mcp-client": "workspace:^",
    "@dsh-cc/mcp-config": "workspace:^",
    "@dsh-cc/model-aliases": "workspace:^",
    "@dsh-cc/plugin-loader": "workspace:^",
    "@dsh-cc/plugin-manager": "workspace:^",
    "@dsh-cc/session-title-provider": "workspace:^",
    "@dsh-cc/settings-ns": "workspace:^",
    "@dsh-cc/systemone": "workspace:^",
    "@dsh-cc/tools": "workspace:^"
  },
  "devDependencies": {
    "@dsh-cc/settings-provider": "workspace:^",
