{
  "name": "@dsh-cc/bundle-permissions",
  "version": "0.6.3-rc.2",
  "description": "Claude Code permission parity layer for dsh profiles: five-level settings cascade + CC permission-rule engine",
  "type": "module",
  "files": [
    "cordis.patch.yml"
  ],
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-cc/dsh-cc.git",
    "directory": "packages/bundle/cc-permissions"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@dsh-cc/settings-cascade": "workspace:^",
    "@dsh-cc/permission-rules": "workspace:^",
    "@dsh-cc/command-permissions": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
