{
  "name": "@dsh-cc/web-fetch-http",
  "description": "CC host-plane HTTP(S) fetch provider: wraps the harness HttpFetchProvider with a literal SSRF gate (private/loopback/link-local block) and optional http→https upgrade",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-cc/dsh-cc.git",
    "directory": "packages/web/fetch-http"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@deepseek-ai/dsh-web-fetch-http": "^0.1.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-web": ">=0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-invariants": "link:../../../../deepseek-harness/packages/runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-web": "link:../../../../deepseek-harness/packages/web/web",
    "@deepseek-ai/dsh-web-fetch-http": "link:../../../../deepseek-harness/packages/web/web-fetch-http",
    "@deepseek-ai/schemastery": "link:../../../../deepseek-harness/vendor/schemastery"
  },
  "publishConfig": {
    "access": "public"
  }
}
