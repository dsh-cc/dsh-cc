{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(edit|write)$|^mcp__serena__(replace_symbol_body|replace_content|replace_in_files|insert_before_symbol|insert_after_symbol|rename_symbol|safe_delete_symbol)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/post-edit-diagnostics-nudge.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/serena-failure-watchdog.mjs\" advise",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__serena__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/serena-failure-watchdog.mjs\" record",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
