# Local pre-commit = seconds-level static gates only. Typecheck, bundle,
# check:exports, the full vitest suite, subagent-paste and the profile-boot
# smoke run in CI (.github/workflows/presubmit.yml), which is the merge gate.
# Run any of them locally on demand (pnpm typecheck / pnpm test / …).
# Worktree self-heal: worktrees have no node_modules (gitignored); before
# the first commit, run `pnpm install --frozen-lockfile` automatically if
# dependencies aren't installed (hard-links from the global store — see
# docs/dev.md).
set -e   # husky's real commit path already runs sh -e; this guards bare
         # invocation and husky-version drift

# git injects repo-bound variables into hook environments
# (GIT_INDEX_FILE=.git/index, relative to the top level). Descendant
# processes that invoke git from another cwd would resolve a misaligned
# index; unset the whole family so in-gate git behaves like manual
# invocation (docs/dev.md).
unset GIT_INDEX_FILE GIT_PREFIX GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR \
      GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE

# Lockfile guard: pnpm-lock.yaml must have neither unstaged drift nor a
# conflict state. Changing workspace dependencies requires `pnpm install`
# and staging pnpm-lock.yaml in the same commit.
if ! git diff --quiet -- pnpm-lock.yaml; then
  echo "pre-commit: pnpm-lock.yaml has unstaged drift or a conflict state." >&2
  echo "  regenerate and stage it (pnpm install && git add pnpm-lock.yaml)" >&2
  echo "  or revert it (git restore pnpm-lock.yaml), then recommit." >&2
  exit 1
fi

if [ ! -e node_modules ]; then pnpm install --frozen-lockfile; fi

# Static gates, same order as presubmit (plain node, no build needed).
node scripts/check-spec-deps.mjs
node scripts/check-project-identity.mjs
node scripts/check-publish-manifests.mjs
node scripts/check-readme.mjs
node scripts/marketplace.test.mjs
node scripts/check-file-size.mjs
node scripts/check-tui-boundary.mjs
node scripts/check-deep-src-imports.mjs
node scripts/check-vendor-purity.mjs
node scripts/check-capability-evidence.mjs
node scripts/generate-parity-matrix.mjs --check
