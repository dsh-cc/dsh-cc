{
  "name": "dsh-cc",
  "version": "0.6.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -b tsconfig.packages.json && pnpm run bundle:client",
    "prepare": "husky",
    "bundle:client": "pnpm --filter @dsh-cc/command-permissions run bundle",
    "typecheck": "tsc -b tsconfig.packages.json",
    "test": "vitest run",
    "test:e2e": "python3 packages/ui/tui/scripts/e2e/run_core.py",
    "check:exports": "node scripts/check-export-targets.mjs",
    "check:capabilities": "node scripts/check-capability-evidence.mjs",
    "check:parity": "node scripts/generate-parity-matrix.mjs --check",
    "check:subagent-paste": "node scripts/check-subagent-paste.test.mjs",
    "check:spec-deps": "node scripts/check-spec-deps.mjs",
    "check:publish": "node scripts/check-publish-manifests.mjs",
    "check:readme": "node scripts/check-readme.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check:size:ratchet": "node scripts/check-file-size.mjs --ratchet",
    "check:tui-boundary": "node scripts/check-tui-boundary.mjs",
    "check:vendor-purity": "node scripts/check-vendor-purity.mjs",
    "docs:parity": "node scripts/generate-parity-matrix.mjs",
    "report:freshness": "node scripts/report-capability-freshness.mjs",
    "test:capabilities": "node scripts/check-capability-evidence.test.mjs && node scripts/generate-parity-matrix.test.mjs",
    "release": "node scripts/release.mjs",
    "check:deep-imports": "node scripts/check-deep-src-imports.mjs",
    "check:identity": "node scripts/check-project-identity.mjs",
    "smoke:profile-boot": "bash scripts/smoke-profile-boot.sh"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "@vitest/coverage-v8": "4.1.8",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.8",
    "@types/node": "^22.20.0",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0"
  }
}
