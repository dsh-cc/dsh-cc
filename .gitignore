# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Build output (dsh package layout: lib/ holds tsc emit)
lib/

# Staged CC preset copies (generated by packages/ui/tui/scripts/stage-preset.mjs)
packages/ui/tui/presets/

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Accidental in-place tsc emit (tsc -b run without the repo's lib outDir)
packages/**/src/*.js
packages/**/src/*.d.ts
packages/**/src/*.js.map
packages/**/src/*.d.ts.map

# Claude Code worktrees for isolated parallel execution (untracked machine dir).
# Note .claude/agents/ stays tracked.
.claude/worktrees/

# Serena project config + memories are tracked (shared across worktrees
# per serena's official worktree guidance); serena's own .serena/.gitignore
# keeps cache/ and project.local.yml machine-local.

# scripts/lib/ contains source, not build output. A middle-slash pattern is
# root-anchored, so each nested scripts/lib needs its own negation — first
# party: the codex-bridge launcher's shared modules.
!scripts/lib/
!/packages/plugin/cc-codex-bridge/scripts/lib/

# Test-suite scratch dirs (workflow-journal/tool-workflow suites seed temp
# journals here relative to the run cwd; regenerated on every run)
.scratch/

# cc-codex-bridge launcher spec runtime dirs (fake codex stub fixtures,
# regenerated per run under tests/.runtime/<pid>-<rand>/)
/packages/plugin/cc-codex-bridge/tests/.runtime/
